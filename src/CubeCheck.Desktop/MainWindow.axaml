<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CubeCheck.Desktop.MainWindow"
        Title="CubeCheck"
        Width="980" Height="780"
        MinWidth="920" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="CardBorder" Selector="Border">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <LayoutTransformControl x:Name="ZoomHost">
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="1" ScaleY="1"/>
    </LayoutTransformControl.LayoutTransform>
    <Grid x:Name="RootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="36"/>
      </Grid.RowDefinitions>

      <Border x:Name="Sidebar" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
              Padding="12,10,16,10" PointerMoved="OnSidebarPointerMoved">
        <Grid>
          <Border x:Name="SidebarGlow" IsHitTestVisible="False"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock x:Name="SidebarTitle" Text="МЕНЮ" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
              <Button x:Name="BtnProgramsToggle" Theme="{StaticResource NavButton}" Click="OnTogglePrograms" Margin="0,4,0,2">
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="ProgramsArrow"
                        Data="M 0,0 L 6,3.5 L 0,7 Z"
                        Width="8" Height="8"
                        Stretch="Uniform"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                      <RotateTransform x:Name="ProgramsArrowRot" Angle="0"/>
                    </Path.RenderTransform>
                  </Path>
                  <TextBlock x:Name="SecPrograms" Text="ПРОГРАММЫ" FontSize="11" FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <StackPanel x:Name="ProgramsList" IsVisible="False" Margin="0,2,0,0"/>
              <Border x:Name="Sep1" Height="1" Margin="0,8,0,8"/>
              <TextBlock x:Name="SecCheck" Text="ПРОВЕРКА" FontSize="11" FontWeight="Bold" Margin="0,4,0,2"/>
              <Button x:Name="BtnAutoCheck" Theme="{StaticResource NavButton}" Content="Автопроверка" Click="OnAutoCheck"/>
              <Button x:Name="BtnSaveReport" Theme="{StaticResource NavButton}" Content="Сохранить отчёт" Click="OnSaveReport"/>
              <Button x:Name="BtnClearLogs" Theme="{StaticResource NavButton}" Content="Очистить логи" Click="OnClearLogs"/>
              <Border x:Name="Sep2" Height="1" Margin="0,8,0,8"/>
              <TextBlock x:Name="SecComponents" Text="КОМПОНЕНТЫ" FontSize="11" FontWeight="Bold" Margin="0,4,0,2"/>
              <Button x:Name="BtnComponents" Theme="{StaticResource NavButton}" Content="Компоненты" Click="OnComponents"/>
              <Border x:Name="Sep3" Height="1" Margin="0,8,0,8"/>
              <TextBlock x:Name="SecSettings" Text="НАСТРОЙКИ" FontSize="11" FontWeight="Bold" Margin="0,4,0,2"/>
              <Button x:Name="BtnSettings" Theme="{StaticResource NavButton}" Content="Настройки" Click="OnSettings"/>
              <Border x:Name="Sep4" Height="1" Margin="0,8,0,8"/>
              <TextBlock x:Name="SecInfo" Text="ИНФО" FontSize="11" FontWeight="Bold" Margin="0,4,0,2"/>
              <Button x:Name="BtnAbout" Theme="{StaticResource NavButton}" Content="О программе" Click="OnAbout"/>
              <Button x:Name="BtnSystem" Theme="{StaticResource NavButton}" Content="Система" Click="OnSystem"/>
              <Button x:Name="BtnHoly" Theme="{StaticResource NavButton}" Content="HolyCheck" Click="OnHolyCheck"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border x:Name="ContentPane" Grid.Row="0" Grid.Column="1" Padding="20" CornerRadius="8">
        <Grid>
          <ScrollViewer x:Name="ViewUtils" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="UtilsHost"/>
          </ScrollViewer>
          <ScrollViewer x:Name="ViewComponents" IsVisible="False" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ComponentsHost"/>
          </ScrollViewer>
          <Grid x:Name="ViewAutoCheck" IsVisible="False">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="AutoCheckTitle" Text="АВТОПРОВЕРКА" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBox x:Name="AutoCheckBody" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12" BorderThickness="0" AcceptsReturn="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </Grid>
          <Border x:Name="ViewAbout" IsVisible="False" Background="Transparent" PointerMoved="OnAboutPointerMoved">
            <Grid>
              <Border x:Name="AboutGlow" IsHitTestVisible="False"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="AboutBody" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
              </ScrollViewer>
            </Grid>
          </Border>
          <Border x:Name="ViewSystem" IsVisible="False" Background="Transparent" PointerMoved="OnSystemPointerMoved">
            <Grid>
              <Border x:Name="SystemGlow" IsHitTestVisible="False"/>
              <StackPanel>
                <TextBlock x:Name="SystemTitle" Text="СИСТЕМА" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock x:Name="SysUser" Margin="0,0,0,6"/>
                <TextBlock x:Name="SysComputer" Margin="0,0,0,6"/>
                <TextBlock x:Name="SysWindows" Margin="0,0,0,16"/>
                <Button x:Name="BtnSysInfo" Theme="{StaticResource AccentButton}" Content="О системе"
                        HorizontalAlignment="Left" Width="110" Height="32" Click="OnSystemInfo"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid x:Name="ViewSettings" IsVisible="False">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SettingsHost" Margin="0,0,22,0"/>
            </ScrollViewer>
            <Button x:Name="BtnReset" Grid.Row="1" Theme="{StaticResource AccentButton}"
                    Content="Сброс всех настроек" Height="32" Margin="0,12,0,0" Click="OnResetSettings"/>
          </Grid>

          <Border x:Name="UndoToast" IsVisible="False" VerticalAlignment="Bottom"
                  HorizontalAlignment="Center" Padding="16,10" CornerRadius="6"
                  BorderThickness="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="UndoLabel" Text="Настройки сброшены" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock x:Name="UndoSecs" FontSize="13" Margin="12,0,12,0" VerticalAlignment="Center"/>
              <Button x:Name="BtnUndo" Theme="{StaticResource AccentButton}" Content="Вернуть"
                      Width="110" Height="32" Click="OnUndoReset"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="Footer" Grid.Row="1" Grid.Column="1" Padding="12,6" PointerMoved="OnFooterPointerMoved">
        <Grid>
          <Border x:Name="FooterGlow" IsHitTestVisible="False"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="FooterVersion" FontSize="12"/>
            <TextBlock Text="  •  " x:Name="FooterSep1"/>
            <TextBlock x:Name="FooterTelegram" Text="@cubecheck" FontSize="12" Cursor="Hand"
                       PointerReleased="OnTelegram"
                       PointerEntered="OnTelegramEnter" PointerExited="OnTelegramLeave"/>
            <TextBlock Text="  •  " x:Name="FooterSep2"/>
            <TextBlock x:Name="FooterAuthors" FontSize="12"/>
          </StackPanel>
        </Grid>
      </Border>

      <Popup x:Name="ColorPopup" Placement="Bottom" HorizontalOffset="0" VerticalOffset="6"
             IsLightDismissEnabled="True">
        <Border Background="#1A1A24" BorderBrush="#3C3C4E" BorderThickness="1"
                CornerRadius="10" Padding="12"
                BoxShadow="0 6 18 0 #73000000">
          <StackPanel Orientation="Horizontal">
            <Canvas x:Name="SvCanvas" Width="188" Height="188" ClipToBounds="True"
                    PointerPressed="OnSvDown" PointerMoved="OnSvMove" PointerReleased="OnSvUp">
              <Rectangle x:Name="SvHueRect" Width="188" Height="188">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="White" Offset="0"/>
                    <GradientStop Color="Red" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Rectangle Width="188" Height="188" IsHitTestVisible="False">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="Black" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Ellipse x:Name="SvKnob" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                       IsHitTestVisible="False"/>
            </Canvas>
            <Canvas x:Name="HueCanvas" Width="24" Height="188" Margin="12,0,0,0"
                    PointerPressed="OnHueDown" PointerMoved="OnHueMove" PointerReleased="OnHueUp">
              <Rectangle Canvas.Left="4" Width="16" Height="188">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFF0000" Offset="0"/>
                    <GradientStop Color="#FFFFFF00" Offset="0.167"/>
                    <GradientStop Color="#FF00FF00" Offset="0.333"/>
                    <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                    <GradientStop Color="#FF0000FF" Offset="0.667"/>
                    <GradientStop Color="#FFFF00FF" Offset="0.833"/>
                    <GradientStop Color="#FFFF0000" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Border x:Name="HueThumb" Canvas.Left="0" Width="24" Height="10" CornerRadius="3"
                      Background="#F2F2F6" BorderBrush="#181822" BorderThickness="1" IsHitTestVisible="False"/>
            </Canvas>
          </StackPanel>
        </Border>
      </Popup>

      <Grid x:Name="DialogOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="False" ZIndex="30">
        <Border x:Name="DialogDim" Background="#96000000" PointerPressed="OnDialogDimClick"/>
        <Border x:Name="DialogCard" Width="320" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="18,16" CornerRadius="8" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="DialogTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock x:Name="DialogBody" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="DialogLink" FontSize="13" Margin="0,6,0,0" Cursor="Hand"
                       IsVisible="False" PointerReleased="OnDialogLink"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
              <Button x:Name="DialogOk" Theme="{StaticResource AccentButton}" Width="110" Height="32"
                      Margin="0,0,10,0" Click="OnDialogOk"/>
              <Button x:Name="DialogCancel" Theme="{StaticResource AccentButton}" Width="110" Height="32"
                      Click="OnDialogCancel"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </LayoutTransformControl>
</Window>
