<Application x:Class="CubeCheck.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CcBlack" Color="#000000"/>
    <SolidColorBrush x:Key="CcBg" Color="#0A0A0F"/>
    <SolidColorBrush x:Key="CcCard" Color="#15151F"/>
    <SolidColorBrush x:Key="CcSelect" Color="#252540"/>
    <SolidColorBrush x:Key="CcAccent" Color="#8A7AD8"/>
    <SolidColorBrush x:Key="CcGold" Color="#D4AF37"/>
    <SolidColorBrush x:Key="CcFg" Color="#E0E0F0"/>
    <SolidColorBrush x:Key="CcDim" Color="#A0AABF"/>
    <SolidColorBrush x:Key="CcBorder" Color="#3A3A55"/>
    <SolidColorBrush x:Key="CcButton" Color="#1C1C2E"/>
    <SolidColorBrush x:Key="CcInput" Color="#0C0C14"/>
    <SolidColorBrush x:Key="CcOutline" Color="#6A6A88"/>
    <SolidColorBrush x:Key="CcTrack" Color="#3A3A50"/>

    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource CcFg}"/>
      <Setter Property="Background" Value="{DynamicResource CcAccent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CcAccent}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinWidth" Value="100"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource CcFg}"/>
      <Setter Property="Background" Value="{DynamicResource CcButton}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CcOutline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#20202E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CcCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource CcFg}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                      Background="{DynamicResource CcInput}"
                      BorderBrush="{DynamicResource CcOutline}" BorderThickness="1">
                <Path x:Name="mark" Data="M3,8 L7,12 L13,4" Stroke="{DynamicResource CcAccent}"
                      StrokeThickness="2" Visibility="Collapsed" Stretch="None"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                ContentSource="Content"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="box" Property="Background" Value="{DynamicResource CcSelect}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
